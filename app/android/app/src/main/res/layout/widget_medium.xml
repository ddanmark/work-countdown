<?xml version="1.0" encoding="utf-8"?>
<!--
  中尺寸桌面小部件（默认 5x3）—— 三圈进度设计：
  顶行：状态标签 + 走秒指针环
  中部：今日 / 本周 / 本月 三个独立圈；每圈一个进度弧（按完成度填充），
        圈内显示 倒计时 + 已赚工资
  底部：今日工作进度条
  进度弧 = widget_arc_{0..100}.xml 帧图，由 Provider 用 setImageResource 按 % 选择。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_palette_0"
    android:id="@+id/widget_root"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶行：状态 + 走秒指针环 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="距下班"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <ImageView
                android:id="@+id/widget_ring"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/widget_ring"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- 三个圈：今日 / 本周 / 本月 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <!-- 今日 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/widget_today_arc"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_arc_0"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="今日"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp"
                        android:includeFontPadding="false" />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp">
                        <Chronometer
                            android:id="@+id/widget_today_chr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="#FFFFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="11sp"
                            android:autoSizeMaxTextSize="18sp"
                            android:autoSizeStepGranularity="1sp" />
                        <TextView
                            android:id="@+id/widget_today_txt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="0:00:00"
                            android:textColor="#FFFFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="11sp"
                            android:autoSizeMaxTextSize="18sp"
                            android:autoSizeStepGranularity="1sp"
                            android:visibility="gone" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/widget_today_earned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="¥0.00"
                        android:textColor="#FFFFD166"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </FrameLayout>

            <!-- 本周 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/widget_week_arc"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_arc_0"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本周"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/widget_week_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="0时"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="11sp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeStepGranularity="1sp" />
                    <TextView
                        android:id="@+id/widget_week_earned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="¥0.00"
                        android:textColor="#FFFFD166"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </FrameLayout>

            <!-- 本月 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/widget_month_arc"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_arc_0"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本月"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/widget_month_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="0天"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="11sp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeStepGranularity="1sp" />
                    <TextView
                        android:id="@+id/widget_month_earned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="¥0.00"
                        android:textColor="#FFFFD166"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
