<?xml version="1.0" encoding="utf-8"?>
<!--
  小尺寸桌面小部件（默认 4x1）：单行紧凑布局。
  指针环 + 状态标签 + 倒计时(Chronometer 每秒自走) + 下班时间。
  不带进度条(单行高度放不下);倒计时为核心。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_palette_0"
    android:id="@+id/widget_root"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 走秒指针环（28dp：为 8 字符倒计时让宽度） -->
        <ImageView
            android:id="@+id/widget_ring"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/widget_ring"
            android:importantForAccessibility="no" />

        <!-- 状态标签 -->
        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="距下班"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:includeFontPadding="false" />

        <!-- 倒计时(Chronometer 每秒自走；TextView 兜底静态状态)。
             注意 autoSizeTextType 在 RemoteViews 上实际不生效，宽度必须靠
             固定 textSize 保证："11:56:16"(8字符) 在 3 格宽下需 ≤20sp -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp">
            <Chronometer
                android:id="@+id/widget_countdown_chr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/widget_countdown_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0:00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
