<?xml version="1.0" encoding="utf-8"?>
<!--
  圆环尺寸桌面小部件（默认 2x2）：单个大进度环，
  圈内显示 今日倒计时 + 已赚工资。进度弧按今日完成度填充。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_palette_0"
    android:id="@+id/widget_root"
    android:padding="6dp">

    <ImageView
        android:id="@+id/widget_compact_arc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:src="@drawable/widget_arc_0"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="距下班"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:includeFontPadding="false" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <Chronometer
                android:id="@+id/widget_countdown_chr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeStepGranularity="1sp" />
            <TextView
                android:id="@+id/widget_countdown_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0:00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeStepGranularity="1sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_compact_earned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="¥0.00"
            android:textColor="#FFFFD166"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:includeFontPadding="false" />
    </LinearLayout>
</FrameLayout>
