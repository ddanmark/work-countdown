/* 扫码取文件 — 全屏取景页 */
page { background: #000; }

.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #000;
}

.cam {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.cam-error {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}
.cam-error-text {
  color: #ffb4b4;
  font-size: 26rpx;
  line-height: 1.7;
  text-align: center;
}

.veil {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at 50% 50%, rgba(0, 0, 0, 0) 38%, rgba(0, 0, 0, 0.55) 78%);
  pointer-events: none;
}

/* ---------- 取景框 ---------- */
.frame {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 76vw;
  height: 76vw;
  transform: translate(-50%, -50%);
  pointer-events: none;
}
.cross-h {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 1px;
  background: rgba(255, 255, 255, 0.3);
}
.cross-v {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1px;
  background: rgba(255, 255, 255, 0.3);
}
.corner {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.85);
}
.corner.tl { left: 0; top: 0; border-right: 0; border-bottom: 0; border-radius: 12rpx 0 0 0; }
.corner.tr { right: 0; top: 0; border-left: 0; border-bottom: 0; border-radius: 0 12rpx 0 0; }
.corner.bl { left: 0; bottom: 0; border-right: 0; border-top: 0; border-radius: 0 0 0 12rpx; }
.corner.br { right: 0; bottom: 0; border-left: 0; border-top: 0; border-radius: 0 0 12rpx 0; }
.frame.scanning .corner { border-color: #ffd166; }
.frame.hit .corner { border-color: #4ade80; }

/* ---------- 顶栏 ---------- */
.head {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  padding: 100rpx 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.icon-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.35);
  background: rgba(0, 0, 0, 0.42);
  color: #fff;
  font-size: 32rpx;
  line-height: 76rpx;
  text-align: center;
}
.chip {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.42);
  color: #fff;
  font-size: 24rpx;
}

/* ---------- 底栏 ---------- */
.foot {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 40rpx 60rpx;
}
.status {
  color: #fff;
  font-size: 27rpx;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.9);
  margin-bottom: 18rpx;
  min-height: 36rpx;
}
.bars {
  display: flex;
  flex-direction: column;
}
.bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.25);
  overflow: hidden;
  margin-bottom: 12rpx;
}
.bar-in {
  height: 100%;
  width: 0;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #667eea, #4ade80);
  transition: width 0.2s linear;
}
.tools {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}
.tool {
  margin: 0 12rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1px solid rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 24rpx;
}
.hint {
  margin-top: 26rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
