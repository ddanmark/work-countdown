/* ============================================================
   app.wxss — 全局主题与公共样式
   主题：紫蓝渐变 + 半透明玻璃卡片 + 金色强调
   ============================================================ */

page {
  /* —— 主题色变量（组件可通过 addGlobalClass 继承） —— */
  --bg-1: #667eea;
  --bg-2: #764ba2;
  --card: rgba(255, 255, 255, 0.14);
  --card-solid: rgba(255, 255, 255, 0.16);
  --card-border: rgba(255, 255, 255, 0.25);
  --text: #ffffff;
  --text-dim: rgba(255, 255, 255, 0.78);
  --accent: #ffd166;
  --danger: #ff6b6b;
  --ok: #06d6a0;

  /* 全屏紫蓝渐变背景（180deg：顶部恒为 --bg-1，与导航条同色，无接缝）*/
  background: linear-gradient(180deg, var(--bg-1) 0%, var(--bg-2) 100%);
  background-attachment: fixed;
  min-height: 100vh;
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
  box-sizing: border-box;
}

view, text { box-sizing: border-box; }

/* —— 页面根容器 —— */
.root {
  position: relative;
  width: 100%;
  min-height: 100vh;
  padding: calc(16rpx + env(safe-area-inset-top)) 28rpx env(safe-area-inset-bottom);
}

/* —— 玻璃卡片 —— */
.card {
  position: relative;
  border: 1rpx solid var(--card-border);
  border-radius: 28rpx;
  padding: 20rpx 12rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
}

/* —— 分区标题 —— */
.section { margin-bottom: 24rpx; }
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: var(--text);
}

/* —— 页面内标题行 —— */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}
.title { font-size: 38rpx; font-weight: 600; letter-spacing: 1rpx; }

/* 齿轮按钮 */
.gear-btn {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 1rpx solid var(--card-border);
  background: rgba(255, 255, 255, 0.12);
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
  padding: 0;
}
.gear-btn::after { border: none; }
.gear-btn:active { background: rgba(255, 255, 255, 0.28); }

/* —— 状态徽章 —— */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 28rpx;
}
.status {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.18);
}
.status.working { background: rgba(6, 214, 160, 0.32); }
.status.break   { background: rgba(255, 209, 102, 0.32); }
.status.off     { background: rgba(255, 107, 107, 0.32); }
.status.before  { background: rgba(255, 255, 255, 0.18); }
.status.holiday { background: rgba(255, 107, 107, 0.36); }
.next-break-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(255, 209, 102, 0.25);
  border: 1rpx solid rgba(255, 209, 102, 0.4);
  color: #ffd166;
}

/* —— 按钮 —— */
.btn {
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  text-align: center;
  border: 1rpx solid var(--card-border);
  background: rgba(255, 255, 255, 0.12);
  color: var(--text);
  line-height: 1.3;
}
.btn::after { border: none; }
.btn:active { opacity: 0.7; }
.btn-ghost { background: rgba(255, 255, 255, 0.1); }
.btn-primary { background: var(--accent); color: #4a3a00; border-color: var(--accent); }
.btn-block { display: block; width: 100%; }
.btn-danger { color: var(--danger); border-color: rgba(255,107,107,0.5); }

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.actions .btn { flex: 1; }

/* —— 开关 switch 容器 —— */
.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  font-size: 28rpx;
}
.toggle-row .desc { font-size: 24rpx; color: var(--text-dim); }

/* 微信原生 switch 主题色 */
switch .wx-switch-input.wx-switch-input-checked { background: var(--accent) !important; border-color: var(--accent) !important; }

/* —— 进度条 —— */
.progress-wrap { margin-top: 8rpx; }
.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--text-dim);
  margin-bottom: 12rpx;
}
.progress-bar {
  height: 18rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--ok), var(--accent));
  border-radius: 999rpx;
  transition: width 0.3s ease;
}
.earned { color: var(--accent); margin-left: 12rpx; font-variant-numeric: tabular-nums; }

/* —— 子信息 —— */
.sub-info {
  font-size: 26rpx;
  color: var(--text-dim);
  margin: 8rpx 0 20rpx;
  line-height: 1.6;
}
.sub-info .b { color: var(--accent); font-weight: 600; }

/* —— 提示文案 —— */
.hint { font-size: 24rpx; color: var(--text-dim); line-height: 1.5; margin: 8rpx 0; }
.duration-hint { font-size: 24rpx; color: var(--text-dim); margin-top: 10rpx; line-height: 1.5; }

/* —— Tab 切换条 —— */
.tab-bar {
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 16rpx;
  padding: 6rpx;
}
.tab-btn {
  flex: 1;
  font-size: 26rpx;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 12rpx;
  color: var(--text-dim);
}
.tab-btn::after { border: none; }
.tab-btn.active { background: var(--accent); color: #4a3a00; font-weight: 600; }

/* —— 输入框（深色玻璃风） —— */
.input {
  background: rgba(255,255,255,0.12);
  border: 1rpx solid var(--card-border);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  color: var(--text);
  font-size: 28rpx;
  min-width: 0;
}
.input-placeholder { color: rgba(255,255,255,0.5); }

/* —— picker 触发器（看起来像输入框） —— */
.picker-trigger {
  background: rgba(255,255,255,0.12);
  border: 1rpx solid var(--card-border);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.picker-trigger .ph { color: rgba(255,255,255,0.5); }
.picker-trigger .arrow { color: var(--text-dim); font-size: 22rpx; }

/* —— 浮动按钮 —— */
.fab {
  position: fixed;
  left: 36rpx;
  bottom: calc(15rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255,255,255,0.3), rgba(255,255,255,0.15));
  border: 1rpx solid var(--card-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  z-index: 50;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.25);
}
.fab::after { border: none; }
.fab:active { transform: scale(0.92); }
